rules_version = '2';
// GG-Training: Fortschritt pro Konto (Firebase Authentication, E-Mail + Passwort).
// Jedes Konto darf nur sein eigenes Dokument users/{uid} lesen, schreiben und löschen.
// Auflisten und alles andere ist verboten.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['d', 't', 'v'])
          && d.d is string && d.d.size() < 300000
          && d.t is int && d.t > 1700000000000 && d.t < 4100000000000
          && d.v == 1;
      }
      allow get, delete: if isOwner();
      allow create, update: if isOwner() && validData();
      allow list: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
