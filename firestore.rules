rules_version = '2';
// GG-Training: Fortschritt per Lerncode, ohne Login.
// Wer einen Lerncode kennt, darf genau dieses eine Dokument lesen und schreiben.
// Auflisten, Löschen und alles andere ist verboten.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sync/{code} {
      function validCode() {
        return code.matches('^[A-HJ-NP-Z2-9]{12}$');
      }
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['d', 't', 'v'])
          && d.d is string && d.d.size() < 300000
          && d.t is int && d.t > 1700000000000 && d.t < 4100000000000
          && d.v == 1;
      }
      allow get: if validCode();
      allow create, update: if validCode() && validData();
      allow list, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
